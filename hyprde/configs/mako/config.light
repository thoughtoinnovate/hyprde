# Mako Light Configuration
layer=overlay
anchor=top-right
font=JetBrainsMono Nerd Font 11
background-color=#ffffffD9
text-color=#1a1a1aff
width=350
height=120
max-history=10
padding=15
border-size=3
border-color=#0066cc4d
progress-color=over #0066ccff
border-radius=15
default-timeout=3000
group-by=app-name
icons=1
max-icon-size=48
margin=10

[grouped]
format=<b>%s</b>\n%b
