{
    "layer": "top",
    "position": "top",
    "spacing": 1,
    "modules-left": [
        "group/leftActions",
        "group/leftinfo"
    ],
    "modules-center": [
        "group/centerBar"
    ],
    "modules-right": [
        "tray",
        "group/statusbar"
    ],
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "group/statusbar": {
        "orientation": "horizontal",
        "modules": [
            "custom/record-dot",
            "custom/mic-dot",
            "custom/cam-dot",
            "pulseaudio",
            "network",
            "battery",
            "custom/ps_toggle",
            "custom/metrics",
            "custom/ctrl"
        ]
    },
    "custom/record-dot": {
        "interval": 15,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/screen-record.sh status main",
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/screen-record.sh stop",
        "format": "{text}",
        "tooltip": true
    },
    "custom/metrics": {
        "tooltip": true,
        "tooltip-format": "system-metrics",
        "on-click": "~/.config/hypr/scripts/waybars.sh sys-metrics",
        "format": "{icon}",
        "format-icons": [
            ""
        ]
    },
    "custom/ctrl": {
        "tooltip": true,
        "tooltip-format": "control-center",
        "on-click": "~/.config/hypr/scripts/waybars.sh ctrl-cntr",
        "format": "{icon}",
        "format-icons": [
            "󰍜"
        ]
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"{name}\" })'"
    },
    "group/leftActions": {
        "orientation": "horizontal",
        "modules": [
            "custom/session",
            "hyprland/workspaces"
        ]
    },
    "group/centerBar": {
        "orientation": "horizontal",
        "modules": [
            "clock"
        ]
    },
    "custom/mic-dot": {
        "interval": 15,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/mic.sh status",
        "signal": 1,
        "format": "●",
        "tooltip": true
    },
    "custom/cam-dot": {
        "interval": 15,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/camera.sh status",
        "signal": 2,
        "format": "●",
        "tooltip": true
    },
    "group/critical": {
        "orientation": "horizontal",
        "modules": [
            "custom/mic",
            "custom/camera"
        ]
    },
    "group/leftinfo": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/window"
        ]
    },
    "clock": {
        "class": "common",
        "format": "{:%d %b %y | %I:%M %p}",
        "tooltip": true,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "~/.config/hypr/scripts/toggle_calendar.sh",
        "min-width": 150
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5
    },

    "hyprland/window": {
        "max-length": 50,
        "tooltip": true,
        "tooltip-format": "{title}",
        "min-width": 200
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃠"
        ]
    },
    "network": {
        "format": "{icon} {signalStrength}%",
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}/{cidr}",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format": "{essid}\nIP: {ipaddr}\nSignal: {signalStrength}% \nFrequency: {frequency}MHz",
        "on-click": ""
    },
    "custom/wifi": {
        "interval": 15,
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/wifi.sh status",
        "signal": 3,
        "on-click": "~/.config/hypr/scripts/wifi.sh toggle",
        "format": "{icon}",
        "format-icons": {
            "enabled": "󰖩",
            "disabled": "󰖪"
        },
        "tooltip": true,
        "tooltip-format": "{text}"
    },
    "battery": {
        "interval": 10,
        "states": {
            "warning": 50,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-icons": {
            "discharging": [
                "󰁺",
                "󰁼",
                "󰁾",
                "󰂀",
                "󰁹"
            ],
            "charging": [
                "󰂄"
            ],
            "plugged": [
                "󰚥"
            ],
            "empty": [
                "󰂎"
            ]
        },
        "tooltip": true,
        "classes": {
            "critical": "critical",
            "warning": "warning",
            "normal": "normal"
        }
    },
    "bluetooth": {
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/waybars.sh bluetooth",
        "on-click-right": "~/.config/hypr/scripts/bluetooth.sh toggle",
        "format": "{icon}",
        "format-icons": {
            "default": [
                "󰂯"
            ],
            "on": [
                "󰂯"
            ],
            "disabled": [
                "󰂲"
            ],
            "off": [
                "󰂲"
            ]
        },
        "tooltip-format": "Bluetooth: {status}"
    },
    "custom/session": {
        "format": "{icon}",
        "format-icons": [
            "󰀉"
        ],
        "tooltip": true,
        "tooltip-format": "User: {text}",
        "on-click": "~/.config/hypr/scripts/session_menu.sh",
        "exec": "whoami",
        "interval": "once"
    },
    "custom/gpu-usage": {
        "exec": "~/.config/hypr/scripts/gpu_monitor.sh",
        "format": "{icon} {text}",
        "format-icons": [
            "󰢮"
        ],
        "return-type": "text",
        "interval": 3,
        "tooltip-format": "GPU Usage: {text}"
    },
    "memory": {
        "format": "{icon} {percentage}%",
        "format-icons": [
            "󰍛"
        ],
        "states": {
            "warning": 40,
            "critical": 80
        },
        "tooltip": true,
        "tooltip-format": "RAM: {used}/{total} GiB",
        "interval": 5
    },
    "cpu": {
        "interval": 3,
        "format": "{icon} {usage}%",
        "format-icons": [
            "󰻠"
        ],
        "states": {
            "warning": 50,
            "critical": 70
        },
        "tooltip": true,
        "on-click": "xfce4-taskmanager"
    },
    "custom/temperature": {
        "exec": "~/.config/hypr/scripts/temperature.sh all",
        "return-type": "json",
        "format": "{icon} {text}°C",
        "format-icons": [
            "󰜗",
            "󰸁",
            "󱃂",
            "󰸁"
        ],
        "interval": 5,
        "tooltip": true
    },
    "custom/gammastep": {
        "format": "{icon}",
        "format-icons": {
            "enabled": "",
            "disabled": ""
        },
        "on-click-right": "bash ~/.config/hypr/scripts/gammastep/gamma_inc.sh",
        "on-click": "bash ~/.config/hypr/scripts/gammastep/gamma_dec.sh",
        "on-click-middle": "bash ~/.config/hypr/scripts/gammastep/gamma_toggle.sh",
        "tooltip-format": "NightLight {text}"
    },
    "custom/ps_toggle": {
        "return-type": "json",
        "exec": "~/.config/hypr/scripts/power-mode.sh status",
        "signal": 7,
        "on-click": "~/.config/hypr/scripts/power-mode.sh cycle",
        "on-click-right": "~/.config/hypr/scripts/power_usr.sh toggle",
        "interval": 15,
        "format": "{}",
        "format-icons": {
            "balanced": "󰾅",
            "high": "󰐧",
            "auto": "󰑮",
            "saver": "󰈐",
            "high-tlp": "󰓅"
        },
        "tooltip": true
    },
    "custom/mic": {
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/hypr/scripts/mic.sh status",
        "signal": 1,
        "tooltip": true,
        "format": "{icon}",
        "format-icons": [
            "󰍭",
            "󰍮"
        ]
    },
    "custom/camera": {
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/hypr/scripts/camera.sh status",
        "signal": 2,
        "tooltip": true,
        "format": "{icon}",
        "format-icons": [
            "󰗟",
            "󰕧"
        ]
    },
    "custom/wallpaper": {
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/hypr/scripts/wallpaper-ctrl.sh status",
        "on-click": "~/.config/hypr/scripts/wallpaper-ctrl.sh toggle",
        "format": "{icon}",
        "format-icons": [
            "󰸉"
        ],
        "tooltip": true,
        "tooltip-format": "{text}"
    }
}